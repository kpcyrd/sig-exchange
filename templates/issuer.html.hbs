{{#*inline "title"}}
{{ issuer.family }} key: {{ issuer.fingerprint }} - sig.exchange
{{/inline}}
{{#*inline "page"}}

<h2>{{ issuer.family }} key: {{ issuer.fingerprint }}</h2>

{{#if upstreams}}
<h3>Upstream of</h3>
<ul>
    {{#each upstreams}}
    <li><a href="/pkg/{{ this.0.os }}/{{ this.0.name }}">{{ this.0.os }}/{{ this.0.name }}</a> -
        {{#if (eq this.0.last_observed this.1)}}
        ✅ current upstream
        {{else}}
        ⌛️ former upstream
        {{/if}}
    </li>
    {{/each}}
</ul>
{{/if}}

{{#if sigs}}
<h3>Signatures</h3>
<ul>
    {{#each sigs}}
    <li><a href="/-/{{ this.chksum }}">{{ this.chksum }}</a> - (hash_algo={{ this.hash_algo }}, creation_time={{
        this.creation_time }}, digest_prefix={{ this.digest_prefix }})</li>
    {{/each}}
</ul>
{{/if}}

{{#if mpis}}
<h3>Multiprecision Integers</h3>
<pre class="key-dump">{{ mpis }}</pre>
{{/if}}

{{/inline}}
{{> base.html.hbs }}
