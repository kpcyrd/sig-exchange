{{#*inline "title"}}
{{ issuer.family }} key: {{ issuer.fingerprint }} - sig.exchange
{{/inline}}
{{#*inline "page"}}

<h2>{{ issuer.family }} key: {{ issuer.fingerprint }}</h2>

<ul>
{{#each sigs}}
    <li><a href="/sig/{{ this.chksum }}">{{ this.chksum }}</a> - (hash_algo={{ this.hash_algo }}, creation_time={{ this.creation_time }}, digest_prefix={{ this.digest_prefix }})</li>
{{/each}}
</ul>

{{/inline}}
{{> base.html.hbs }}
