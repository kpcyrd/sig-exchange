{{#*inline "title"}}
pkg: {{ os }}/{{ name }} - sig.exchange
{{/inline}}
{{#*inline "page"}}

<h2>pkg: {{ os }}/{{ name }}</h2>

{{#if upstreams}}
<h3>Upstreams</h3>
<ul>
    {{#each upstreams}}
    <li><a href="/issuer/{{ this.0.issuer }}">{{ this.0.issuer }}</a> ({{ this.1 }} pkgs)</li>
    {{/each}}
</ul>
{{/if}}

{{#if pkgs}}
<h3>Releases</h3>
<ul>
    {{#each pkgs}}
    <li><b>{{ this.os }}/{{ this.name }}</b>: {{ this.version }} (release_datetime={{ this.release_datetime }})</li>
    {{/each}}
</ul>
{{/if}}

{{/inline}}
{{> base.html.hbs }}
