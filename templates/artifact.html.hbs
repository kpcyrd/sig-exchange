{{#*inline "title"}}
artifact: {{ chksum }} - sig.exchange
{{/inline}}
{{#*inline "page"}}

<h2>artifact: {{ chksum }}</h2>

{{#if sigs}}
<h3>Signatures</h3>
<ul>
    {{#each sigs}}
    <li><a href="/-/{{ this.sig_chksum }}">{{ this.sig_chksum }}</a>
        <ul>
            <li>
            {{#if (eq this.verified null)}}
            🔮 allegedly
            {{else if this.verified }}
            ✅ verified
            {{else}}
            ❌ failed verification
            {{/if}}
            ({{ this.os }})
            </li>
        </ul>
    </li>
    {{/each}}
</ul>
{{/if}}

{{/inline}}
{{> base.html.hbs }}
