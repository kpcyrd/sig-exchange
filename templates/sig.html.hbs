{{#*inline "title"}}
sig.exchange
{{/inline}}
{{#*inline "page"}}

<h2>{{ sig.family }} sig: {{ sig.chksum }}</h2>

<pre>
Issuer: <a href="/issuer/{{ sig.issuer }}">{{ sig.issuer }}</a>
Sig type: {{ sig.sig_type }}
Sig version: {{ sig.sig_version }}
Hash algo: {{ sig.hash_algo }}
Sig algo: {{ sig.sig_algo }}
Creation time: {{ sig.creation_time }}
Digest prefix: {{ sig.digest_prefix }}
</pre>

{{#if artifacts}}
<h3>Artifacts</h3>
<ul>
    {{#each artifacts}}
    <li><a href="/artifact/{{ this.artifact_chksum }}">{{ this.artifact_chksum }}</a>
        <ul>
            <li>
            {{#if (eq this.verified null)}}
            🔮 allegedly
            {{else if this.verified }}
            ✅ verified
            {{else}}
            ❌ failed verification
            {{/if}}
            ({{ this.os }})
            </li>
        </ul>
    </li>
    {{/each}}
</ul>
{{/if}}

<pre id="sig">{{ armored }}</pre>

{{/inline}}
{{> base.html.hbs }}
